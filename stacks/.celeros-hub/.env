# .env da stack celeros-hub — NAO e lido pelo `docker stack deploy` (isso e
# coisa do `docker compose`). Serve de referencia central dos valores usados
# nos `environment:` do compose e para ferramentas que rodam no servidor.
#
# O segredo da area admin NAO vive aqui: e um Docker secret externo
# (celeros_hub_admin_token) criado no Swarm com:
#   printf 'SEU-TOKEN' | docker secret create celeros_hub_admin_token -

APP_ENV=production
HUB_DOMAIN=os.celer.tec.br
HUB_PORT=8080
BASE_URL=https://os.celer.tec.br
