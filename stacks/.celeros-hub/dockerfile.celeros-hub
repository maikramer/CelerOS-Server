# =============================================================================
# dockerfile.celeros-hub — imagem custom da stack (fluxo build do denv)
# =============================================================================
# A TAG da imagem e a VERSAO DO SERVICO (HUB_VERSION em api/app.py), nao da
# base:
#
#   denv build --service celeros-hub --tag 0.3.0 --push
#   denv update celeros-hub -t 0.3.0
#
# Subiu a versao do hub no app.py? Build/deploy com a tag nova — tag que nao
# existe no registry forca build de verdade (o mesmo tag reescrito deixava o
# `denv update` pular o build e reimplantar codigo velho). Mudou a base
# python? Edite o FROM abaixo (fixada de proposito; o denv reescreve o
# `ARG BASE_TAG` com a tag do deploy, que aqui e so um no-op).

ARG BASE_TAG=0.8.0
FROM python:3.12.10-alpine

# Dependencias pinadas (fastapi traz starlette/pydantic; multipart p/ upload).
RUN pip install --no-cache-dir \
      fastapi==0.115.12 \
      "uvicorn[standard]==0.34.2" \
      python-multipart==0.0.20

WORKDIR /app

# Contexto = pasta da stack (stacks/.celeros-hub/); o codigo da API vive no
# repo em api/ e entra no build via link relativo ao contexto.
COPY api/app.py /app/app.py

EXPOSE 8080

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]