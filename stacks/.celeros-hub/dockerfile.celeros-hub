# =============================================================================
# dockerfile.celeros-hub — imagem custom da stack (fluxo build do denv)
# =============================================================================
# Padrao do datacenter: a MESMA tag versiona a base e a imagem produzida.
# Aqui a base e a imagem oficial do Python, entao:
#
#   denv start celeros-hub -t 3.12.10
#     1. reescreve ARG BASE_TAG= com 3.12.10
#     2. docker build -t locatelli/celeros-hub:3.12.10 -f
#        dockerfile.celeros-hub stacks/.celeros-hub
#     3. push + deploy interpolando locatelli/celeros-hub:3.12.10
#
# Mudou o codigo/conteudo? Rebuild com a mesma tag e `denv update` — o Swarm
# re-resolve a imagem (--resolve-image always). Mudou a base python? Suba a
# tag (ex.: 3.13.2) e ajuste o default no docker-compose.yml.

ARG BASE_TAG=3.12.10

FROM python:${BASE_TAG}-alpine

# Dependencias pinadas (fastapi traz starlette/pydantic; multipart p/ upload).
RUN pip install --no-cache-dir \
      fastapi==0.115.12 \
      "uvicorn[standard]==0.34.2" \
      python-multipart==0.0.20

WORKDIR /app

# Contexto = pasta da stack (stacks/.celeros-hub/); o codigo da API vive no
# repo em api/ e entra no build via link relativo ao contexto.
COPY api/app.py /app/app.py

EXPOSE 8080

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]